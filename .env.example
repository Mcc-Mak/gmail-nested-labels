# Gmail account (for IMAP login)
GMAIL_USER=your-email@gmail.com

# Gmail App Password (generate at https://myaccount.google.com/apppasswords)
# Requires 2-Step Verification enabled on your Google account
GMAIL_APP_PASSWORD=your-16-char-app-password

# Google AI Studio API key for Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-api-key-here

# Number of latest Inbox emails to process
EMAIL_COUNT=10

# Gemini model used for thematic analysis
GEMINI_MODEL=gemini-1.5-flash
